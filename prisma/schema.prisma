datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

// ────────────────────────────────────────────────────────────
// SETTINGS (single-row config: Telnyx API key, from number, balance)
// ────────────────────────────────────────────────────────────
model Setting {
  id          String   @id @default(cuid())
  provider    String   @default("telnyx")
  accountSid  String?  @default("")
  authToken   String?  @default("")
  fromPhone   String?  @default("+18884020949")
  balance     Float    @default(25.0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

// ────────────────────────────────────────────────────────────
// CONTACT GROUPS
// ────────────────────────────────────────────────────────────
model ContactGroup {
  id          String    @id @default(cuid())
  name        String    @unique
  color       String?   @default("#6366f1")
  description String?
  contacts    Contact[]
  createdAt   DateTime  @default(now())
}

// ────────────────────────────────────────────────────────────
// CONTACTS
// ────────────────────────────────────────────────────────────
model Contact {
  id          String        @id @default(cuid())
  name        String
  phone       String
  email       String?
  countryCode String?
  status      String        @default("active") // active, unsubscribed, blocked
  tags        String[]
  groupId     String?
  group       ContactGroup? @relation(fields: [groupId], references: [id])
  messages    Message[]
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  @@index([phone])
}

// ────────────────────────────────────────────────────────────
// TEMPLATES
// ────────────────────────────────────────────────────────────
model Template {
  id        String     @id @default(cuid())
  name      String
  channel   String     @default("sms")
  subject   String?
  content   String
  category  String     @default("General")
  variables String[]
  campaigns Campaign[]
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt
}

// ────────────────────────────────────────────────────────────
// CAMPAIGNS
// ────────────────────────────────────────────────────────────
model Campaign {
  id           String    @id @default(cuid())
  name         String
  channel      String    @default("sms")
  templateId   String?
  template     Template? @relation(fields: [templateId], references: [id])
  groupName    String?   @default("All Contacts")
  status       String    @default("draft") // draft, running, completed, failed
  scheduledAt  DateTime?
  sentCount    Int       @default(0)
  delivCount   Int       @default(0)
  failedCount  Int       @default(0)
  cost         Float     @default(0.0)
  messages     Message[]
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  @@index([status])
}

// ────────────────────────────────────────────────────────────
// SMS MESSAGES
// ────────────────────────────────────────────────────────────
model Message {
  id          String    @id @default(cuid())
  contactId   String?
  contact     Contact?  @relation(fields: [contactId], references: [id])
  campaignId  String?
  campaign    Campaign? @relation(fields: [campaignId], references: [id])
  direction   String    @default("outbound")
  toPhone     String
  fromPhone   String?
  content     String
  countryCode String?
  status      String    @default("pending") // delivered, sent, failed, pending, queued
  cost        Float     @default(0.0)
  providerSid String?
  errorCode   String?
  sentAt      DateTime  @default(now())

  @@index([sentAt])
  @@index([toPhone])
}
