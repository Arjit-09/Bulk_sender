datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

// ────────────────────────────────────────────────────────────
// SUBSCRIPTION PLANS
// ────────────────────────────────────────────────────────────
model Plan {
  id            String         @id @default(cuid())
  name          String         @unique // Starter, Growth, Enterprise
  slug          String         @unique // starter, growth, enterprise
  price         Float          // monthly price in USD
  annualPrice   Float          @default(0)
  smsLimit      Int            @default(1000)  // monthly SMS
  waLimit       Int            @default(500)   // monthly WhatsApp
  emailLimit    Int            @default(5000)  // monthly Email
  contactLimit  Int            @default(500)
  teamLimit     Int            @default(1)     // seats
  features      String[]       // list of feature keys
  isActive      Boolean        @default(true)
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt

  organizations Organization[]
}

// ────────────────────────────────────────────────────────────
// ORGANIZATION (Tenant)
// ────────────────────────────────────────────────────────────
model Organization {
  id              String    @id @default(cuid())
  name            String
  slug            String    @unique
  logo            String?
  website         String?
  industry        String?
  planId          String?
  plan            Plan?     @relation(fields: [planId], references: [id])
  subscriptionStatus String @default("trial") // trial, active, past_due, cancelled
  trialEndsAt     DateTime?
  billingEmail    String?
  stripeCustomerId String?
  stripeSubId     String?
  smsUsed         Int       @default(0)
  waUsed          Int       @default(0)
  emailUsed       Int       @default(0)
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  members         OrgMember[]
  campaigns       Campaign[]
  contacts        Contact[]
  contactGroups   ContactGroup[]
  templates       Template[]
  messages        Message[]
  waMessages      WAMessage[]
  emailMessages   EmailMessage[]
  apiKeys         ApiKey[]
  settings        OrgSetting?
  countryTargets  CountryTarget[]
  webhooks        Webhook[]
}

// ────────────────────────────────────────────────────────────
// USERS & ROLES
// ────────────────────────────────────────────────────────────
enum UserRole {
  SUPER_ADMIN
  ADMIN
  MEMBER
  VIEWER
}

model User {
  id           String      @id @default(cuid())
  email        String      @unique
  name         String?
  avatarUrl    String?
  role         UserRole    @default(MEMBER)
  passwordHash String?
  isActive     Boolean     @default(true)
  lastLoginAt  DateTime?
  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt

  memberships  OrgMember[]
  auditLogs    AuditLog[]
}

model OrgMember {
  id             String       @id @default(cuid())
  userId         String
  user           User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  role           UserRole     @default(MEMBER)
  invitedAt      DateTime     @default(now())
  joinedAt       DateTime?
  isOwner        Boolean      @default(false)

  @@unique([userId, organizationId])
  @@index([organizationId])
}

// ────────────────────────────────────────────────────────────
// COUNTRY TARGETING
// ────────────────────────────────────────────────────────────
model CountryTarget {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  countryCode    String       // ISO 3166-1 alpha-2: IN, US, GB, AU, etc.
  countryName    String
  dialCode       String       // +91, +1, +44
  isEnabled      Boolean      @default(true)
  smsEnabled     Boolean      @default(true)
  waEnabled      Boolean      @default(true)
  emailEnabled   Boolean      @default(true)
  createdAt      DateTime     @default(now())

  @@unique([organizationId, countryCode])
}

// ────────────────────────────────────────────────────────────
// CONTACTS
// ────────────────────────────────────────────────────────────
model ContactGroup {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  name           String
  color          String?      @default("#6366f1")
  description    String?
  contacts       Contact[]
  createdAt      DateTime     @default(now())

  @@unique([organizationId, name])
}

model Contact {
  id             String        @id @default(cuid())
  organizationId String
  organization   Organization  @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  name           String
  phone          String
  email          String?
  countryCode    String?       // ISO code for this contact's country
  status         String        @default("active") // active, unsubscribed, bounced, blocked
  tags           String[]
  customFields   Json?
  groupId        String?
  group          ContactGroup? @relation(fields: [groupId], references: [id])
  messages       Message[]
  waMessages     WAMessage[]
  emailMessages  EmailMessage[]
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  @@index([phone])
  @@index([organizationId])
}

// ────────────────────────────────────────────────────────────
// TEMPLATES (shared across SMS / WA / Email)
// ────────────────────────────────────────────────────────────
model Template {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  name           String
  channel        String       @default("sms") // sms, whatsapp, email
  subject        String?      // for email
  content        String
  htmlContent    String?      // rich HTML for email
  category       String       @default("General")
  variables      String[]     // placeholder vars like {{name}}, {{company}}
  isApproved     Boolean      @default(true) // WA templates need approval
  campaigns      Campaign[]
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
}

// ────────────────────────────────────────────────────────────
// CAMPAIGNS (multi-channel)
// ────────────────────────────────────────────────────────────
model Campaign {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  name           String
  channel        String       @default("sms") // sms, whatsapp, email
  templateId     String?
  template       Template?    @relation(fields: [templateId], references: [id])
  groupName      String?      @default("All Contacts")
  targetCountries String[]    // ISO country codes to target
  status         String       @default("draft") // draft, scheduled, running, completed, paused, failed
  scheduledAt    DateTime?
  sentCount      Int          @default(0)
  delivCount     Int          @default(0)
  failedCount    Int          @default(0)
  openCount      Int          @default(0) // email opens
  clickCount     Int          @default(0) // email clicks
  cost           Float        @default(0.0)
  messages       Message[]
  waMessages     WAMessage[]
  emailMessages  EmailMessage[]
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  @@index([organizationId])
  @@index([status])
}

// ────────────────────────────────────────────────────────────
// SMS MESSAGES
// ────────────────────────────────────────────────────────────
model Message {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  contactId      String?
  contact        Contact?     @relation(fields: [contactId], references: [id])
  campaignId     String?
  campaign       Campaign?    @relation(fields: [campaignId], references: [id])
  direction      String       @default("outbound")
  toPhone        String
  fromPhone      String?
  content        String
  countryCode    String?
  status         String       @default("pending") // delivered, sent, failed, pending
  cost           Float        @default(0.0)
  providerSid    String?
  errorCode      String?
  sentAt         DateTime     @default(now())

  @@index([sentAt])
  @@index([toPhone])
  @@index([organizationId])
}

// ────────────────────────────────────────────────────────────
// WHATSAPP MESSAGES
// ────────────────────────────────────────────────────────────
model WAMessage {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  contactId      String?
  contact        Contact?     @relation(fields: [contactId], references: [id])
  campaignId     String?
  campaign       Campaign?    @relation(fields: [campaignId], references: [id])
  direction      String       @default("outbound")
  toPhone        String
  fromPhone      String?
  content        String
  mediaUrl       String?
  templateName   String?
  countryCode    String?
  status         String       @default("pending") // sent, delivered, read, failed
  cost           Float        @default(0.0)
  providerMsgId  String?
  sentAt         DateTime     @default(now())

  @@index([sentAt])
  @@index([organizationId])
}

// ────────────────────────────────────────────────────────────
// EMAIL MESSAGES
// ────────────────────────────────────────────────────────────
model EmailMessage {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  contactId      String?
  contact        Contact?     @relation(fields: [contactId], references: [id])
  campaignId     String?
  campaign       Campaign?    @relation(fields: [campaignId], references: [id])
  toEmail        String
  fromEmail      String?
  fromName       String?
  subject        String
  htmlContent    String?
  textContent    String?
  countryCode    String?
  status         String       @default("pending") // queued, sent, delivered, opened, clicked, bounced, failed
  openedAt       DateTime?
  clickedAt      DateTime?
  bouncedAt      DateTime?
  providerMsgId  String?
  sentAt         DateTime     @default(now())

  @@index([sentAt])
  @@index([organizationId])
}

// ────────────────────────────────────────────────────────────
// ORG SETTINGS (provider credentials per org)
// ────────────────────────────────────────────────────────────
model OrgSetting {
  id              String       @id @default(cuid())
  organizationId  String       @unique
  organization    Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  // SMS
  smsProvider     String       @default("twilio") // twilio, vonage, aws_sns
  twilioSid       String?      @default("")
  twilioToken     String?      @default("")
  twilioFrom      String?      @default("")
  // WhatsApp
  waProvider      String       @default("twilio") // twilio, meta
  waFromPhone     String?      @default("")
  waAccessToken   String?      @default("")
  waPhoneId       String?      @default("")
  // Email
  emailProvider   String       @default("sendgrid") // sendgrid, ses, mailgun, smtp
  emailApiKey     String?      @default("")
  emailFromAddr   String?      @default("")
  emailFromName   String?      @default("")
  smtpHost        String?
  smtpPort        Int?         @default(587)
  smtpUser        String?
  smtpPass        String?
  updatedAt       DateTime     @updatedAt
}

// ────────────────────────────────────────────────────────────
// API KEYS
// ────────────────────────────────────────────────────────────
model ApiKey {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  name           String
  keyHash        String       @unique
  prefix         String       // first 8 chars for display
  scopes         String[]     // sms:send, wa:send, email:send, contacts:read
  lastUsedAt     DateTime?
  expiresAt      DateTime?
  isActive       Boolean      @default(true)
  createdAt      DateTime     @default(now())
}

// ────────────────────────────────────────────────────────────
// WEBHOOKS
// ────────────────────────────────────────────────────────────
model Webhook {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  url            String
  events         String[]     // message.delivered, campaign.completed, etc.
  secret         String?
  isActive       Boolean      @default(true)
  failCount      Int          @default(0)
  lastTriggeredAt DateTime?
  createdAt      DateTime     @default(now())
}

// ────────────────────────────────────────────────────────────
// AUDIT LOGS
// ────────────────────────────────────────────────────────────
model AuditLog {
  id             String    @id @default(cuid())
  userId         String?
  user           User?     @relation(fields: [userId], references: [id])
  organizationId String?
  action         String    // user.login, campaign.created, plan.upgraded
  resource       String?   // Campaign, Contact, etc.
  resourceId     String?
  metadata       Json?
  ipAddress      String?
  userAgent      String?
  createdAt      DateTime  @default(now())

  @@index([organizationId])
  @@index([createdAt])
}
