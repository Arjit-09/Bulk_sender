datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

model User {
  id           String     @id @default(cuid())
  email        String     @unique
  name         String?
  balance      Float      @default(25.0)
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt

  contacts     Contact[]
  templates    Template[]
  campaigns    Campaign[]
  messages     Message[]
  settings     Setting?
}

model ContactGroup {
  id        String    @id @default(cuid())
  name      String    @unique
  color     String?   @default("#6366f1")
  contacts  Contact[]
  createdAt DateTime  @default(now())
}

model Contact {
  id        String        @id @default(cuid())
  name      String
  phone     String
  email     String?
  status    String        @default("active") // active, unsubscribed, bounced
  userId    String?
  user      User?         @relation(fields: [userId], references: [id], onDelete: Cascade)
  groupId   String?
  group     ContactGroup? @relation(fields: [groupId], references: [id])
  messages  Message[]
  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt

  @@index([phone])
}

model Template {
  id        String     @id @default(cuid())
  name      String
  content   String
  category  String     @default("General") // Onboarding, Promotions, Transactional, Reminders
  userId    String?
  user      User?      @relation(fields: [userId], references: [id], onDelete: Cascade)
  campaigns Campaign[]
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt
}

model Campaign {
  id          String    @id @default(cuid())
  name        String
  userId      String?
  user        User?     @relation(fields: [userId], references: [id], onDelete: Cascade)
  templateId  String?
  template    Template? @relation(fields: [templateId], references: [id])
  groupName   String?   @default("All Contacts")
  status      String    @default("completed") // draft, scheduled, running, completed, paused
  scheduledAt DateTime?
  sentCount   Int       @default(0)
  delivCount  Int       @default(0)
  failedCount Int       @default(0)
  cost        Float     @default(0.0)
  messages    Message[]
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
}

model Message {
  id          String    @id @default(cuid())
  userId      String?
  user        User?     @relation(fields: [userId], references: [id], onDelete: Cascade)
  contactId   String?
  contact     Contact?  @relation(fields: [contactId], references: [id])
  campaignId  String?
  campaign    Campaign? @relation(fields: [campaignId], references: [id])
  direction   String    @default("outbound") // outbound, inbound
  toPhone     String
  fromPhone   String?
  content     String
  status      String    @default("delivered") // delivered, sent, failed, pending
  cost        Float     @default(0.0079)
  providerSid String?
  sentAt      DateTime  @default(now())

  @@index([sentAt])
  @@index([toPhone])
}

model Setting {
  id         String   @id @default(cuid())
  userId     String?  @unique
  user       User?    @relation(fields: [userId], references: [id], onDelete: Cascade)
  provider   String   @default("twilio")
  accountSid String?  @default("")
  authToken  String?  @default("")
  fromPhone  String?  @default("")
  balance    Float    @default(25.0)
  updatedAt  DateTime @updatedAt
}

// Tenant-isolated SaaS tables. Legacy tables above are retained for migration only.
model Account {
  id String @id @default(cuid())
  email String @unique
  name String
  passwordHash String
  superAdmin Boolean @default(false)
  memberships Membership[]
  sessions Session[]
  createdAt DateTime @default(now())
}
model Workspace {
  id String @id @default(cuid())
  name String
  suspended Boolean @default(false)
  plan String @default("starter")
  subscriptionStatus String @default("trial")
  subscriptionId String? @unique
  planVersionId String?
  planVersion PricingVersion? @relation(fields: [planVersionId], references: [id])
  billingThrough DateTime?
  supportConnections SupportConnection[]
  conversations Conversation[]
  members Membership[]
  contacts AudienceContact[]
  templates Blueprint[]
  campaigns Broadcast[]
  connections ChannelConnection[]
  deliveries Delivery[]
  events AuditEvent[]
  usage UsagePeriod[]
  createdAt DateTime @default(now())
}
model Membership {
  id String @id @default(cuid())
  accountId String
  workspaceId String
  role String @default("member")
  account Account @relation(fields: [accountId], references: [id], onDelete: Cascade)
  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  @@unique([accountId, workspaceId])
}
model Session {
  tokenHash String @id
  accountId String
  workspaceId String
  expiresAt DateTime
  account Account @relation(fields: [accountId], references: [id], onDelete: Cascade)
  @@index([expiresAt])
}
model AudienceContact {
  id String @id @default(cuid())
  workspaceId String
  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  name String
  destination String
  channel String
  consentSource String
  consentAt DateTime
  unsubscribedAt DateTime?
  createdAt DateTime @default(now())
  @@unique([workspaceId, channel, destination])
}
model Blueprint {
  id String @id @default(cuid())
  workspaceId String
  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  name String
  channel String
  subject String?
  content String
  providerTemplateId String?
  dltTemplateId String?
  language String @default("en_US")
  approval String @default("draft")
  createdAt DateTime @default(now())
  @@index([workspaceId])
}
model Broadcast {
  id String @id @default(cuid())
  workspaceId String
  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  name String
  channel String
  templateId String
  status String @default("draft")
  scheduledAt DateTime?
  deliveries Delivery[]
  createdAt DateTime @default(now())
  @@index([workspaceId, createdAt])
}
model ChannelConnection {
  id String @id @default(cuid())
  workspaceId String
  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  channel String
  sender String
  encryptedSecret String
  entityId String?
  status String @default("pending")
  updatedAt DateTime @updatedAt
  @@unique([workspaceId, channel])
  @@unique([channel, sender])
}
model Delivery {
  id String @id @default(cuid())
  workspaceId String
  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  campaignId String
  campaign Broadcast @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  contactId String
  destination String
  channel String
  content String
  subject String?
  templateRef String?
  language String
  status String @default("queued")
  providerId String? @unique
  error String?
  availableAt DateTime @default(now())
  claimedAt DateTime?
  updatedAt DateTime @updatedAt
  createdAt DateTime @default(now())
  @@unique([campaignId, contactId])
  @@index([status, availableAt])
  @@index([workspaceId, createdAt])
}
model UsagePeriod {
  id String @id @default(cuid())
  workspaceId String
  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  month String
  reserved Int @default(0)
  @@unique([workspaceId, month])
}
model AuditEvent {
  id String @id @default(cuid())
  workspaceId String
  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  actorId String
  action String
  detail String
  createdAt DateTime @default(now())
  @@index([workspaceId, createdAt])
}
model WebhookReceipt {
  id String @id
  createdAt DateTime @default(now())
}
model RateBucket {
  key String @id
  count Int @default(1)
  expiresAt DateTime
}

model SupportConnection {
  id String @id @default(cuid())
  workspaceId String
  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  provider String
  address String
  senderName String
  encryptedKey String
  encryptedWebhookSecret String
  status String @default("pending")
  conversations Conversation[]
  createdAt DateTime @default(now())
  @@unique([provider, address])
  @@index([workspaceId])
}
model Conversation {
  id String @id @default(cuid())
  workspaceId String
  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  connectionId String
  connection SupportConnection @relation(fields: [connectionId], references: [id])
  peer String
  name String
  subject String @default("")
  threadKey String @default("")
  status String @default("open")
  assigneeId String?
  blocked Boolean @default(false)
  lastInboundAt DateTime
  lastMessageAt DateTime @default(now())
  messages SupportMessage[]
  reads ConversationRead[]
  createdAt DateTime @default(now())
  @@unique([connectionId, peer, threadKey])
  @@index([workspaceId, status, lastMessageAt])
}
model SupportMessage {
  id String @id @default(cuid())
  conversationId String
  conversation Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  direction String
  body String
  actorId String?
  clientKey String? @unique
  providerKey String? @unique
  emailMessageId String?
  templateId String?
  status String
  error String?
  claimedAt DateTime?
  createdAt DateTime @default(now())
  @@index([status, createdAt])
  @@index([conversationId, createdAt])
}
model ConversationRead {
  id String @id @default(cuid())
  conversationId String
  conversation Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  accountId String
  readAt DateTime
  @@unique([conversationId, accountId])
}
model PricingVersion {
  id String @id @default(cuid())
  planKey String
  name String
  pricePaise Int
  dispatchLimit Int
  seats Int
  razorpayPlanId String @unique
  published Boolean @default(false)
  workspaces Workspace[]
  createdAt DateTime @default(now())
  @@index([planKey, published, createdAt])
}
