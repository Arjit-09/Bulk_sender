{
  "name": "bulk-sms-platform",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "postinstall": "prisma generate",
    "test": "tsc lib/platform/policy.ts lib/platform/crypto.ts lib/platform/providers.ts --outDir .test-build --module commonjs --target es2022 --esModuleInterop --skipLibCheck && node --test tests/policy.test.cjs",
    "test:integration": "node --test tests/integration.test.cjs",
    "db:deploy": "prisma migrate deploy",
    "admin:promote": "node scripts/promote-admin.cjs",
    "worker": "node scripts/worker.mjs",
    "typecheck": "tsc --noEmit",
    "test:browser": "playwright test",
    "format": "prettier --write app components/Platform.tsx lib/platform tests scripts next.config.ts playwright.config.ts README.md docs"
  },
  "dependencies": {
    "@prisma/client": "6.4.1",
    "clsx": "^2.1.1",
    "lucide-react": "^1.44.0",
    "next": "^16.4.3",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "svix": "^2.9.1",
    "tailwind-merge": "^3.6.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "^16.4.3",
    "prettier": "^3.9.10",
    "prisma": "6.4.1",
    "tailwindcss": "^4",
    "typescript": "^5"
  }
}
