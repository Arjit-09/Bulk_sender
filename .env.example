# Never commit real credentials. Use a secret manager in production.
DATABASE_URL=postgresql://pulse:change-me@localhost:5432/pulse?schema=public
APP_URL=http://localhost:3000
ALLOW_SIGNUP=false
# Generate separately: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ENCRYPTION_KEY=
WORKER_SECRET=
# Pin a currently supported Graph API version from Meta documentation.
META_GRAPH_VERSION=
META_APP_SECRET=
META_VERIFY_TOKEN=
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
# Create monthly INR plans matching lib/platform/policy.ts (amounts in paise).
RAZORPAY_PLAN_STARTER=
RAZORPAY_PLAN_GROWTH=
RAZORPAY_PLAN_SCALE=
